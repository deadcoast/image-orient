# Normalize line endings in the index; keep working trees native.
* text=auto

# Shell and CI files must stay LF everywhere.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# PowerShell tooling is authored for Windows hosts.
*.ps1 text eol=crlf

# Never rewrite binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.heic binary
*.avif binary
*.onnx binary
*.svg text
