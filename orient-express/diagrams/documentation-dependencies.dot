digraph DocumentationDependencies {
  graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.25", ranksep="0.7", compound=true];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=9, color="#475569", margin="0.08,0.05"];
  edge [color="#64748b", arrowsize=0.6, penwidth=0.8];
  subgraph cluster_root {
    label="Root";
    color="#cbd5e1"; style="rounded";
    "DOC-CHANGELOG" [label="DOC-CHANGELOG\nDevelopment Specification Changelog", fillcolor="#f3f4f6"];
    "DOC-CONTRIB" [label="DOC-CONTRIB\nContributing to the Development Specification", fillcolor="#f3f4f6"];
    "DOC-LICENSE" [label="DOC-LICENSE\nLicensing and Third-Party Notice Plan", fillcolor="#f3f4f6"];
    "DOC-MASTER" [label="DOC-MASTER\nPhotoUpright Master Development Specification", fillcolor="#f3f4f6"];
    "DOC-INDEX" [label="DOC-INDEX\nPhotoUpright Development Specification Index", fillcolor="#f3f4f6"];
    "DOC-STATUS" [label="DOC-STATUS\nPhotoUpright Planning Status", fillcolor="#f3f4f6"];
  }
  subgraph cluster_00_governance {
    label="Governance";
    color="#cbd5e1"; style="rounded";
    "DOC-ASSUMPTIONS" [label="DOC-ASSUMPTIONS\nAssumptions and Open Questions", fillcolor="#e0f2fe"];
    "DOC-DECISIONS" [label="DOC-DECISIONS\nArchitecture Decision Log", fillcolor="#e0f2fe"];
    "DOC-GOVMODEL" [label="DOC-GOVMODEL\nDocumentation Model and Governance", fillcolor="#e0f2fe"];
    "DOC-GLOSSARY" [label="DOC-GLOSSARY\nGlossary", fillcolor="#e0f2fe"];
  }
  subgraph cluster_01_product {
    label="Product";
    color="#cbd5e1"; style="rounded";
    "DOC-WORKFLOWS" [label="DOC-WORKFLOWS\nPersonas and Operational Workflows", fillcolor="#dcfce7"];
    "DOC-CHARTER" [label="DOC-CHARTER\nProduct Charter", fillcolor="#dcfce7"];
    "DOC-PRD" [label="DOC-PRD\nProduct Requirements", fillcolor="#dcfce7"];
    "DOC-SCOPE" [label="DOC-SCOPE\nScope and Release Policy", fillcolor="#dcfce7"];
  }
  subgraph cluster_02_research {
    label="Research";
    color="#cbd5e1"; style="rounded";
    "DOC-RESEARCH" [label="DOC-RESEARCH\nResearch Summary", fillcolor="#fef3c7"];
    "DOC-LANDSCAPE" [label="DOC-LANDSCAPE\nSolution Landscape and Fit Assessment", fillcolor="#fef3c7"];
    "DOC-SOURCES" [label="DOC-SOURCES\nResearch Sources and Evidence Register", fillcolor="#fef3c7"];
    "DOC-TECH" [label="DOC-TECH\nTechnology Evaluation and Baseline Stack", fillcolor="#fef3c7"];
  }
  subgraph cluster_03_requirements {
    label="Requirements";
    color="#cbd5e1"; style="rounded";
    "DOC-AC" [label="DOC-AC\nAcceptance Criteria", fillcolor="#ede9fe"];
    "DOC-NFR" [label="DOC-NFR\nNon-Functional Requirements", fillcolor="#ede9fe"];
    "DOC-SRS" [label="DOC-SRS\nSystem Requirements Specification", fillcolor="#ede9fe"];
  }
  subgraph cluster_04_architecture {
    label="Architecture";
    color="#cbd5e1"; style="rounded";
    "DOC-CLI" [label="DOC-CLI\nCLI User Experience and Command Contract", fillcolor="#dbeafe"];
    "DOC-CONTRACTS" [label="DOC-CONTRACTS\nComponent Contracts", fillcolor="#dbeafe"];
    "DOC-CONFIG" [label="DOC-CONFIG\nConfiguration, Schemas, Events, and Compatibility", fillcolor="#dbeafe"];
    "DOC-DATAMODEL" [label="DOC-DATAMODEL\nJob, Event, and Persistence Data Model", fillcolor="#dbeafe"];
    "DOC-FSSAFE" [label="DOC-FSSAFE\nFilesystem Safety, Atomicity, Recovery, and Undo", fillcolor="#dbeafe"];
    "DOC-METADATA" [label="DOC-METADATA\nMetadata, Orientation Semantics, Codecs, and Fidelity", fillcolor="#dbeafe"];
    "DOC-ML" [label="DOC-ML\nML Orientation Engine", fillcolor="#dbeafe"];
    "DOC-PLUGIN" [label="DOC-PLUGIN\nPlugin and Extension Model", fillcolor="#dbeafe"];
    "DOC-PIPELINE" [label="DOC-PIPELINE\nProcessing Pipeline and State Machines", fillcolor="#dbeafe"];
    "DOC-ARCH" [label="DOC-ARCH\nSystem Architecture", fillcolor="#dbeafe"];
  }
  subgraph cluster_05_quality {
    label="Quality";
    color="#cbd5e1"; style="rounded";
    "DOC-COMPAT" [label="DOC-COMPAT\nCompatibility and Qualification Matrix", fillcolor="#fce7f3"];
    "DOC-EVAL" [label="DOC-EVAL\nCorpus, Ground Truth, Calibration, and ML Evaluation Plan", fillcolor="#fce7f3"];
    "DOC-OBS" [label="DOC-OBS\nObservability, Diagnostics, and Supportability", fillcolor="#fce7f3"];
    "DOC-PERF" [label="DOC-PERF\nPerformance, Capacity, and Benchmark Plan", fillcolor="#fce7f3"];
    "DOC-SEC" [label="DOC-SEC\nSecurity, Privacy, and Threat Model", fillcolor="#fce7f3"];
    "DOC-TEST" [label="DOC-TEST\nTest Strategy and Verification Architecture", fillcolor="#fce7f3"];
  }
  subgraph cluster_06_delivery {
    label="Delivery";
    color="#cbd5e1"; style="rounded";
    "DOC-CICD" [label="DOC-CICD\nCI/CD, Reproducibility, and Software Supply Chain", fillcolor="#ffedd5"];
    "DOC-DOD" [label="DOC-DOD\nDefinition of Done and Release Gate Checklist", fillcolor="#ffedd5"];
    "DOC-DEVPLAN" [label="DOC-DEVPLAN\nDevelopment Plan and Execution Governance", fillcolor="#ffedd5"];
    "DOC-RELEASE" [label="DOC-RELEASE\nRelease, Packaging, Installation, Update, and Rollback", fillcolor="#ffedd5"];
    "DOC-RISKS" [label="DOC-RISKS\nRisk Register", fillcolor="#ffedd5"];
    "DOC-SPIKES" [label="DOC-SPIKES\nRisk-First Technical Spikes", fillcolor="#ffedd5"];
    "DOC-WBS" [label="DOC-WBS\nWork Breakdown Structure and Backlog Dependencies", fillcolor="#ffedd5"];
  }
  subgraph cluster_07_traceability {
    label="Traceability";
    color="#cbd5e1"; style="rounded";
    "DOC-DOCGRAPH" [label="DOC-DOCGRAPH\nDocumentation Dependency Graph", fillcolor="#ccfbf1"];
    "DOC-IMPLGRAPH" [label="DOC-IMPLGRAPH\nImplementation Dependency Graph", fillcolor="#ccfbf1"];
    "DOC-TRACEGUIDE" [label="DOC-TRACEGUIDE\nTraceability Guide", fillcolor="#ccfbf1"];
  }
  subgraph cluster_08_adrs {
    label="ADRs";
    color="#cbd5e1"; style="rounded";
    "ADR-0001" [label="ADR-0001\nUse a modular monolith with ports and adapters", fillcolor="#f5f5f4"];
    "ADR-0002" [label="ADR-0002\nUse .NET 10 LTS and C# for the Windows-first implementation", fillcolor="#f5f5f4"];
    "ADR-0003" [label="ADR-0003\nSeparate scan plans from apply", fillcolor="#f5f5f4"];
    "ADR-0004" [label="ADR-0004\nUse ONNX behind a runtime abstraction", fillcolor="#f5f5f4"];
    "ADR-0005" [label="ADR-0005\nUse face-landmark evidence with calibrated abstention", fillcolor="#f5f5f4"];
    "ADR-0006" [label="ADR-0006\nUse ExifTool behind a persistent metadata adapter", fillcolor="#f5f5f4"];
    "ADR-0007" [label="ADR-0007\nUse lossless JPEG DCT transforms when eligible", fillcolor="#f5f5f4"];
    "ADR-0008" [label="ADR-0008\nUse SQLite for durable job state", fillcolor="#f5f5f4"];
    "ADR-0009" [label="ADR-0009\nDefault to safe-copy; guard in-place mode", fillcolor="#f5f5f4"];
    "ADR-0010" [label="ADR-0010\nVersion every external automation contract", fillcolor="#f5f5f4"];
    "ADR-0011" [label="ADR-0011\nDo not load arbitrary in-process plugins in v1", fillcolor="#f5f5f4"];
    "ADR-0012" [label="ADR-0012\nUse risk-first gated delivery", fillcolor="#f5f5f4"];
  }
  "DOC-GOVMODEL" -> "DOC-CONTRIB";
  "DOC-TRACEGUIDE" -> "DOC-CONTRIB";
  "DOC-SOURCES" -> "DOC-LICENSE";
