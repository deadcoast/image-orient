digraph ComponentDependencies {
  graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.25", ranksep="0.7"];
  node [shape=box, style="rounded,filled", fillcolor="#e0f2fe", fontname="Arial", fontsize=9, color="#475569"];
  edge [color="#64748b", arrowsize=0.6];
  "COMP-CLI" [label="COMP-CLI\nCLI Host"];
  "COMP-CONFIG" [label="COMP-CONFIG\nConfiguration"];
  "COMP-CAPABILITIES" [label="COMP-CAPABILITIES\nCapability Probe"];
  "COMP-DISCOVERY" [label="COMP-DISCOVERY\nInput Discovery"];
  "COMP-METADATA" [label="COMP-METADATA\nMetadata Service"];
  "COMP-CODEC" [label="COMP-CODEC\nCodec Service"];
  "COMP-TRANSFORM" [label="COMP-TRANSFORM\nTransform Service"];
  "COMP-INFERENCE" [label="COMP-INFERENCE\nInference Runtime"];
  "COMP-MODELS" [label="COMP-MODELS\nModel Registry"];
  "COMP-FEATURES" [label="COMP-FEATURES\nOrientation Feature Extractor"];
  "COMP-CALIBRATION" [label="COMP-CALIBRATION\nConfidence Calibration"];
  "COMP-POLICY" [label="COMP-POLICY\nDecision Policy"];
  "COMP-ORIENTATION" [label="COMP-ORIENTATION\nOrientation Engine"];
  "COMP-PLANNER" [label="COMP-PLANNER\nPlanner"];
  "COMP-PIPELINE" [label="COMP-PIPELINE\nPipeline Coordinator"];
  "COMP-EXECUTOR" [label="COMP-EXECUTOR\nApply Executor"];
  "COMP-VERIFY" [label="COMP-VERIFY\nIndependent Verifier"];
  "COMP-FILESYSTEM" [label="COMP-FILESYSTEM\nFilesystem Safety Layer"];
  "COMP-JOURNAL" [label="COMP-JOURNAL\nRecovery Journal"];
  "COMP-JOBSTORE" [label="COMP-JOBSTORE\nJob Store"];
  "COMP-REVIEW" [label="COMP-REVIEW\nReview Workflow"];
  "COMP-REPORTING" [label="COMP-REPORTING\nEvents and Reporting"];
  "COMP-BENCHMARK" [label="COMP-BENCHMARK\nBenchmark Harness"];
  "COMP-NATIVE" [label="COMP-NATIVE\nNative Tool Adapter"];
  "COMP-CONFIG" -> "COMP-CLI";
  "COMP-CAPABILITIES" -> "COMP-CLI";
  "COMP-PLANNER" -> "COMP-CLI";
  "COMP-EXECUTOR" -> "COMP-CLI";
  "COMP-REVIEW" -> "COMP-CLI";
  "COMP-REPORTING" -> "COMP-CLI";
  "COMP-CODEC" -> "COMP-CAPABILITIES";
  "COMP-METADATA" -> "COMP-CAPABILITIES";
  "COMP-INFERENCE" -> "COMP-CAPABILITIES";
  "COMP-FILESYSTEM" -> "COMP-CAPABILITIES";
  "COMP-FILESYSTEM" -> "COMP-DISCOVERY";
  "COMP-CONFIG" -> "COMP-DISCOVERY";
  "COMP-NATIVE" -> "COMP-METADATA";
  "COMP-NATIVE" -> "COMP-CODEC";
  "COMP-CODEC" -> "COMP-TRANSFORM";
  "COMP-METADATA" -> "COMP-TRANSFORM";
  "COMP-NATIVE" -> "COMP-TRANSFORM";
  "COMP-MODELS" -> "COMP-INFERENCE";
  "COMP-FILESYSTEM" -> "COMP-MODELS";
  "COMP-INFERENCE" -> "COMP-FEATURES";
  "COMP-FEATURES" -> "COMP-CALIBRATION";
  "COMP-CALIBRATION" -> "COMP-POLICY";
  "COMP-METADATA" -> "COMP-ORIENTATION";
  "COMP-CODEC" -> "COMP-ORIENTATION";
  "COMP-INFERENCE" -> "COMP-ORIENTATION";
  "COMP-FEATURES" -> "COMP-ORIENTATION";
  "COMP-CALIBRATION" -> "COMP-ORIENTATION";
  "COMP-POLICY" -> "COMP-ORIENTATION";
  "COMP-DISCOVERY" -> "COMP-PLANNER";
  "COMP-ORIENTATION" -> "COMP-PLANNER";
