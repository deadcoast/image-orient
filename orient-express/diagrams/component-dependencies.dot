  "COMP-FILESYSTEM" -> "COMP-PLANNER";
  "COMP-CAPABILITIES" -> "COMP-PLANNER";
  "COMP-JOBSTORE" -> "COMP-PIPELINE";
  "COMP-REPORTING" -> "COMP-PIPELINE";
  "COMP-TRANSFORM" -> "COMP-EXECUTOR";
  "COMP-VERIFY" -> "COMP-EXECUTOR";
  "COMP-FILESYSTEM" -> "COMP-EXECUTOR";
  "COMP-JOURNAL" -> "COMP-EXECUTOR";
  "COMP-JOBSTORE" -> "COMP-EXECUTOR";
  "COMP-PIPELINE" -> "COMP-EXECUTOR";
  "COMP-CODEC" -> "COMP-VERIFY";
  "COMP-METADATA" -> "COMP-VERIFY";
  "COMP-NATIVE" -> "COMP-FILESYSTEM";
  "COMP-JOBSTORE" -> "COMP-JOURNAL";
  "COMP-FILESYSTEM" -> "COMP-JOURNAL";
  "COMP-FILESYSTEM" -> "COMP-JOBSTORE";
